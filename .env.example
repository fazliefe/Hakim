HAKIM_DATABASE_URL=postgresql://hakim:hakim@127.0.0.1:5433/hakim
HAKIM_ELASTICSEARCH_URL=http://127.0.0.1:9200
HAKIM_NEO4J_URI=bolt://127.0.0.1:7687
HAKIM_NEO4J_USER=neo4j
HAKIM_NEO4J_PASSWORD=hakim-graph
# Model names live in config/models.yaml (active: groq | ollama | colab | evren)
# HAKIM_PROFILE=groq
HAKIM_LLM_API_KEY=
# Varsayılan: localhost:3000 / 127.0.0.1:3000. Demo günü farklı bir host/IP'den
# açılacaksa virgülle ayırarak buraya ekleyin (kod değişikliği/derleme gerekmez).
# HAKIM_CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
# TEKNOFEST 2026 çıkarım/vektör servisi (https://evren-teknofest.ssyz.org.tr/).
# Takım anahtarları e-posta ile iletilir; buraya gerçek key koymayın.
# HAKIM_PROFILE=evren
# HAKIM_LLM_API_KEY=sk-evren-teamNN-...
# HAKIM_QDRANT_URL=https://evren-vektor.ssyz.org.tr
# HAKIM_QDRANT_PORT=443
# HAKIM_QDRANT_PREFIX=teamNN
# HAKIM_QDRANT_API_KEY=qdr-teamNN-...
# Web (apps/web) API_BASE varsayılanı artık göreli `/api-hakim` — next.config.js
# rewrite'ı bunu backend'e proxy'ler, tarayıcı hiçbir zaman doğrudan localhost:8000'e
# gitmez (Cloudflare Tunnel arkasında da bu yüzden değişiklik gerekmez). Bu satırı
# yalnızca backend'i proxy'yi ATLAYIP doğrudan başka bir origin'den çağırmak
# isterseniz set edin. NOT: Next.js bunu apps/web dizininde çalışır, bu yüzden
# root .env DEĞİL apps/web/.env.local (veya process env) üzerinden okunur.
# NEXT_PUBLIC_HAKIM_API_URL=
# next.config.js'deki rewrite'ın hedefi (server-side, apps/web'in kendi env'i
# üzerinden okunur — bkz. yukarıdaki not). Backend 127.0.0.1:8000'de kalıyorsa
# gerek yok.
# HAKIM_API_ORIGIN=http://127.0.0.1:8000
# İlk admin hesabının parolası (services/auth/store.py::ensure_admin). Set
# edilmezse yalnızca hesap İLK KEZ oluşturulurken rastgele bir parola üretilir
# ve konsola tek seferlik yazdırılır — sabit "admin1234" artık kaynak kodda yok.
# Zaten var olan bir data/accounts.sqlite'taki admin parolasını GERİYE DÖNÜK
# değiştirmez (bkz. docs/competition_deployment.md).
# HAKIM_ADMIN_PASSWORD=
POSTGRES_USER=hakim
POSTGRES_PASSWORD=hakim
POSTGRES_DB=hakim
MINIO_ROOT_USER=hakim
MINIO_ROOT_PASSWORD=hakim-minio
# Langfuse (cloud). Do not commit real keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Optional SMTP for account verification codes
# HAKIM_SMTP_HOST=smtp.example.com
# HAKIM_SMTP_PORT=587
# HAKIM_SMTP_USER=
# HAKIM_SMTP_PASSWORD=
# HAKIM_SMTP_FROM=hakim@example.com
